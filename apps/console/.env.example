# ─────────────────────────────────────────────────────────────
# apps/console (로그인 후 기능 화면) 환경변수 템플릿
#   로컬: cp .env.example .env.local   (.env.local 은 커밋 금지, 내 PC 에서만 읽힘)
#   배포: GitHub 레포 > Settings > Secrets and variables > Actions > Variables 에 같은 이름으로 등록
#         (deploy-console 워크플로가 빌드할 때 주입)
# NEXT_PUBLIC_ 값은 빌드 결과(브라우저 JS)에 그대로 들어가므로 비밀값을 넣지 말 것
# 전체 설명: docs/ENV.md
# ─────────────────────────────────────────────────────────────

# API 서버 주소 (끝 / 없이)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# 메인(마케팅·로그인) 사이트 주소 — 로그인 안 된 사용자를 보내는 곳
NEXT_PUBLIC_WEB_URL=http://localhost:3100

# GitHub Pages 하위 경로. 로컬은 비워 둔다. 배포는 워크플로가 /<레포이름> 으로 자동 설정
NEXT_PUBLIC_BASE_PATH=

# 카카오 디벨로퍼스 > 앱 키 > JavaScript 키 (지도). 플랫폼 > Web 에 콘솔 도메인 등록 필수
# 비우면 지도 없이 코스 편집만 가능
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=
