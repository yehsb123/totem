# ─────────────────────────────────────────────────────────────
# apps/api 환경변수 템플릿. 복사해서 .env 로 쓰고 값을 채운다 (.env 는 커밋 금지)
#   cp .env.example .env
# 전체 설명·등록 위치: docs/ENV.md
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=8000
LOG_LEVEL=info
# 프록시(Render·Fly·Nginx) 뒤에서 운영하면 1
TRUST_PROXY=0

# 비워 두면 개발 시 인메모리 MongoDB + 데모 데이터로 뜬다 (운영 필수)
# 예: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=
MONGO_DB_NAME=totem
# 영속 DB 가 비어 있을 때 기동 시 시드 (개발 전용)
SEED_ON_EMPTY=false
# npm run seed / SEED_ON_EMPTY 때 데모 계정(demo@totem.dev) 비밀번호. 비우면 데모 계정 미생성 (인메모리 DB 만 예외로 demo1234)
SEED_DEMO_PASSWORD=

# 허용 출처: 메인(web) · 콘솔(console). 쉼표 구분, 끝 / 없이. 운영 필수
CORS_ORIGINS=http://localhost:3100,http://localhost:3200

# 운영 필수, 32자 이상 난수:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14
AUTH_HANDOFF_TTL_SECONDS=60
BCRYPT_ROUNDS=12

RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_15MIN=30

# 한국관광공사 TourAPI (공공데이터포털 > 마이페이지 > 일반 인증키 Decoding)
TOURAPI_SERVICE_KEY=
TOURAPI_BASE_URL=https://apis.data.go.kr/B551011/KorService2

# 공용 장소 동기화(TourAPI) 최소 간격(시간) — 호출 한도 보호
PLACE_SYNC_COOLDOWN_HOURS=6

# 카카오 디벨로퍼스 > 앱 키 > REST API 키 (서버 전용, 절대 NEXT_PUBLIC_ 로 쓰지 말 것)
KAKAO_REST_API_KEY=
# 카카오 로그인 > 보안 > Client Secret 을 '사용함'으로 했을 때만
KAKAO_CLIENT_SECRET=
# 카카오 로그인 Redirect URI (카카오 콘솔 등록값과 동일, 쉼표 구분)
KAKAO_REDIRECT_URIS=http://localhost:3100/auth/kakao/callback

# 삭제 표시된 조직을 영구 삭제하기까지 유예 일수 (npm run purge). 결제 기록은 보존
ORG_PURGE_AFTER_DAYS=30

REVIEW_IMPORT_ALLOWED_HOSTS=docs.google.com,googleusercontent.com
REVIEW_IMPORT_MAX_BYTES=2000000
