# ─────────────────────────────────────────────────────────────
# apps/web (메인·로그인 사이트) 환경변수 템플릿
#
# - 로컬 개발: 이 파일을 복사해 apps/web/.env.local 을 만들고 값을 채운다.
#   .env.local 은 절대 커밋하지 않는다 (.gitignore 에 등록되어 있음).
# - 배포(Vercel): 실제 값은 Vercel 대시보드 → Project → Settings →
#   Environment Variables 에 등록한다. (Production / Preview 각각)
#   NEXT_PUBLIC_ 변수는 빌드 시점에 번들에 박히므로 값을 바꾸면 재배포해야 한다.
# - NEXT_PUBLIC_ 로 시작하는 값은 브라우저에 그대로 노출된다. 비밀키를 넣지 말 것.
#
# Vercel 프로젝트 설정 (vercel.json 불필요)
# - Root Directory: apps/web   / Framework Preset: Next.js
# - Install·Build 명령은 기본값. 저장소 루트의 package-lock.json(npm workspaces)을
#   Vercel 이 감지해 루트에서 설치하므로 @totem/shared 도 함께 설치된다.
# - "Include files outside of the Root Directory in the Build Step" 은 켜 둔다
#   (packages/shared 소스를 빌드에 포함해야 함, 기본값 ON).
# ─────────────────────────────────────────────────────────────

# API 서버 주소 (끝에 / 없이, /api/v1 은 붙이지 않는다). 비우면 http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# 로그인 후 이동할 콘솔(GitHub Pages) 주소. 비우면 http://localhost:3200
# 예) https://yehsb123.github.io/totem  (저장소 하위 경로가 있으면 그 경로까지)
NEXT_PUBLIC_CONSOLE_URL=http://localhost:3200

# 이 사이트(메인) 자신의 주소. 카카오 로그인 redirectUri 와 SEO(OG) 기준 주소로 쓴다.
# 비우면 http://localhost:3100. 카카오 개발자 콘솔의 Redirect URI 에
# <이 값>/auth/kakao/callback 을 반드시 등록해야 한다.
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# 카카오 JavaScript 키 (카카오 개발자 콘솔 → 앱 → 앱 키 → JavaScript 키).
# 비워 두면 카카오 로그인 버튼이 표시되지 않는다. (REST API 키 / Admin 키와 혼동 금지)
NEXT_PUBLIC_KAKAO_JS_KEY=
